{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "findmycruise.ie"
        }
      ],
      "destination": "https://www.findmycruise.ie/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/update-flights",
      "schedule": "0 3 * * *"
    }
  ]
}
